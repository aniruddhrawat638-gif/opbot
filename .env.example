# =========================
# DISCORD BOT
# =========================
DISCORD_TOKEN=YOUR_BOT_TOKEN
CLIENT_ID=YOUR_APPLICATION_CLIENT_ID
GUILD_ID=YOUR_SERVER_ID

# Bot owner / super-admin Discord user ID
OWNER_ID=YOUR_OWNER_USER_ID

# =========================
# ELIGIBLE ROLE
# =========================
# ONLY members who have this role earn activity credits.
ELIGIBLE_ROLE_ID=YOUR_ROLE_ID

# =========================
# REWARD MATH
# =========================
# 1500 counted messages = ₹100 OR $1
MESSAGES_PER_PAYOUT=1500
INR_PER_PAYOUT=100
USD_PER_PAYOUT=1

# Therefore:
# 1 counted message/credit = ₹0.0666666667
# 1 counted message/credit = $0.0006666667
#
# The bot stores credits as counted activity units.
# It does NOT send INR/LTC automatically.

# =========================
# ANTI-SPAM
# =========================
# Minimum seconds between counted messages from one user.
ACTIVITY_COOLDOWN_SECONDS=10

# Maximum counted messages per user per IST day.
DAILY_MESSAGE_CAP=500

# Minimum message length to count.
MIN_MESSAGE_LENGTH=5

# =========================
# BRANDING / WATERMARK
# =========================
BOT_NAME=Lovemate • Activity Rewards
WATERMARK_ENABLED=true
WATERMARK_TEXT=Lovemate • Activity Rewards
WATERMARK_ICON=

# =========================
# TIME
# =========================
TIMEZONE=Asia/Kolkata
TIMEZONE_LABEL=IST

REWARDS_FILE=./src/data/rewards.json
WITHDRAWALS_FILE=./src/data/withdrawals.json
CONFIG_FILE=./src/data/config.json
